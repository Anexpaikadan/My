# Daybill Print – Apache settings (XAMPP)
Options -Indexes

# Force HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Block access to config, schema and helper files
<FilesMatch "^(config|lib|printer)\.php$|\.(sql|md|log)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# Allow bigger uploads (mod_php only; for other setups edit php.ini)
<IfModule mod_php.c>
  php_value upload_max_filesize 25M
  php_value post_max_size 260M
  php_value max_file_uploads 20
  php_value max_execution_time 120
</IfModule>
